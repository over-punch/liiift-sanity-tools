# GitHub token. Fine-grained, scoped to only the backup repositories.
#   Actions: Read-only            -> status panel works
#   Actions: Read and write       -> also allows "Back up now"
BACKUP_GITHUB_TOKEN=github_pat_...

# Shared secret the Studio sends on every request. Also set it in the Studio as
# SANITY_STUDIO_BACKUP_STATUS_KEY and pass it as `statusKey`.
BACKUP_STATUS_KEY=

# Allowlist. key:owner/repo/workflow.yml@ref  (ref optional, defaults to main)
# The Studio can only ask for keys that appear here.
BACKUP_TARGETS=mckl:over-punch/mckl-cms/backup-routine.yml,darden:over-punch/Darden-Studio/backup-routine.yml,tdf:over-punch/the-designers-foundry/backup-routine.yml

# Set to false for a read-only proxy (status panel, no triggering).
BACKUP_ALLOW_TRIGGER=true
