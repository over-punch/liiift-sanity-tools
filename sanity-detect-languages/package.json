{
  "name": "@liiift-studio/sanity-detect-languages",
  "version": "1.1.0",
  "description": "Sanity Studio document action that detects the languages a typeface supports from its fonts' character sets, using bundled Hyperglot data",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "scripts",
    "dist",
    "src",
    "NOTICE"
  ],
  "scripts": {
    "build": "npm run test && tsup",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sanity",
    "sanity-studio",
    "typeface",
    "font",
    "languages",
    "hyperglot"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@sanity/ui": ">=2 <5",
    "react": ">=18",
    "sanity": ">=3 <7"
  },
  "devDependencies": {
    "tsup": "^8",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liiift-Studio/liiift-sanity-tools.git",
    "directory": "sanity-detect-languages"
  },
  "dependencies": {
    "@liiift-studio/sanity-ui-compat": "^0.1.2"
  }
}
