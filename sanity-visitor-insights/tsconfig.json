{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"declaration": true,
		"declarationDir": "dist",
		"outDir": "dist",
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"lib": ["ES2020", "DOM"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
